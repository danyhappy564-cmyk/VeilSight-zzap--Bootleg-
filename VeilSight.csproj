<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="VeilSight.local.props" Condition="Exists('VeilSight.local.props')" />

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>VeilSight</AssemblyName>
    <RootNamespace>VeilSight</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <VersionPrefix>1.2.0</VersionPrefix>
    <Version>$(VersionPrefix)</Version>
    <AssemblyVersion>$(VersionPrefix).0</AssemblyVersion>
    <FileVersion>$(VersionPrefix).0</FileVersion>
    <InformationalVersion>$(Version)</InformationalVersion>
    <Deterministic>true</Deterministic>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\$(Configuration)\</OutputPath>
  </PropertyGroup>

  <PropertyGroup>
    <SptRoot Condition="'$(SptRoot)' == '' And '$(SPT_ROOT)' != ''">$(SPT_ROOT)</SptRoot>
    <!-- Fork default: the maintainer's SPT 4.1 install. Override with -p:SptRoot=..., the
         SPT_ROOT environment variable, or VeilSight.local.props. -->
    <SptRoot Condition="'$(SptRoot)' == ''">E:\SPT 4.1</SptRoot>
    <DeployVeilSight Condition="'$(DeployVeilSight)' == ''">false</DeployVeilSight>
    <Managed>$(SptRoot)\EscapeFromTarkov_Data\Managed</Managed>
    <BepInExCore>$(SptRoot)\BepInEx\core</BepInExCore>
    <SptPlugins>$(SptRoot)\BepInEx\plugins\spt</SptPlugins>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>$(BepInExCore)\BepInEx.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExCore)\0Harmony.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(Managed)\Assembly-CSharp.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Comfort">
      <HintPath>$(Managed)\Comfort.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="spt-reflection">
      <HintPath>$(SptPlugins)\spt-reflection.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(Managed)\UnityEngine.CoreModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(Managed)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(Managed)\UnityEngine.PhysicsModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(Managed)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(Managed)\UnityEngine.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <Target Name="ValidateSptRoot" BeforeTargets="ResolveReferences"
          Condition="'$(SptRoot)' == '' Or !Exists('$(SptRoot)\EscapeFromTarkov_Data\Managed\Assembly-CSharp.dll')">
    <Error Text="Set SptRoot to a valid SPT installation using -p:SptRoot=&quot;C:\Path\To\SPT&quot;, the SPT_ROOT environment variable, or VeilSight.local.props." />
  </Target>

  <!--
    The SPT launcher decides which SPT version a plugin was "built for" by reading the version of
    the spt-reflection assembly it references. Building against a placeholder spt-reflection.dll
    (version 1.0.0.0) compiles fine but produces a DLL the launcher refuses to run:
      "These mods were built for a different version of SPT than the one you are running (4.1.5):
       VeilSight.dll (built for SPT 1.0.0)"
    So fail the build early rather than shipping a plugin that cannot load.
  -->
  <Target Name="EnsureRealSptReflection" AfterTargets="ValidateSptRoot" BeforeTargets="BeforeBuild;ResolveAssemblyReferences">
    <GetAssemblyIdentity AssemblyFiles="$(SptPlugins)\spt-reflection.dll">
      <Output TaskParameter="Assemblies" ItemName="_SptReflectionIdentity" />
    </GetAssemblyIdentity>
    <Error Condition="'%(_SptReflectionIdentity.Version)' == '1.0.0.0'"
           Text="spt-reflection.dll under SptRoot '$(SptRoot)' reports version 1.0.0.0, which is a placeholder rather than a real SPT install. A plugin built against it is rejected by the launcher as 'built for SPT 1.0.0'. Point SptRoot at an actual SPT installation." />
    <Message Text="spt-reflection %(_SptReflectionIdentity.Version) - VeilSight.dll will be stamped for that SPT version." Importance="high" />
  </Target>

  <Target Name="GenerateVeilSightVersion" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <VeilSightVersionSource>$(IntermediateOutputPath)VeilSightVersion.g.cs</VeilSightVersionSource>
      <VeilSightVersionText>namespace VeilSight%0A{%0A    internal static class BuildVersion%0A    {%0A        internal const string Value = &quot;$(VersionPrefix)&quot;%3B%0A    }%0A}</VeilSightVersionText>
    </PropertyGroup>
    <WriteLinesToFile File="$(VeilSightVersionSource)" Lines="$(VeilSightVersionText)" Overwrite="true" Encoding="UTF-8" />
    <ItemGroup>
      <Compile Include="$(VeilSightVersionSource)" />
    </ItemGroup>
  </Target>

  <Target Name="CopyVeilSight" AfterTargets="Build" Condition="'$(DeployVeilSight)' == 'true'">
    <MakeDir Directories="$(SptRoot)\BepInEx\plugins\VeilSight" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(SptRoot)\BepInEx\plugins\VeilSight" SkipUnchangedFiles="true" />
  </Target>

  <!--
    Rule 2-2: every Release build also drops a ready-to-ship archive in release/.
    Skip with -p:SkipPackage=true.
  -->
  <Target Name="PackageRelease" AfterTargets="Build"
          Condition="'$(Configuration)' == 'Release' AND '$(SkipPackage)' != 'true'">
    <PropertyGroup>
      <PackageStageDir>$(IntermediateOutputPath)package\</PackageStageDir>
      <PackageZipDir>$(MSBuildThisFileDirectory)release\</PackageZipDir>
      <PackageZipPath>$(PackageZipDir)$(AssemblyName)-$(Version).zip</PackageZipPath>
    </PropertyGroup>
    <ItemGroup>
      <PackageFiles Include="$(OutputPath)**\*" Exclude="$(OutputPath)**\*.pdb;$(OutputPath)**\*.deps.json" />
    </ItemGroup>
    <RemoveDir Directories="$(PackageStageDir)" />
    <Copy SourceFiles="@(PackageFiles)"
          DestinationFiles="@(PackageFiles->'$(PackageStageDir)%(RecursiveDir)%(Filename)%(Extension)')" />
    <MakeDir Directories="$(PackageZipDir)" />
    <Delete Files="$(PackageZipPath)" />
    <ZipDirectory SourceDirectory="$(PackageStageDir)" DestinationFile="$(PackageZipPath)" Overwrite="true" />
    <Message Text="Packaged $(PackageZipPath)" Importance="high" />
  </Target>

</Project>
